---
import 'hotkeypad/reset.css'
import 'hotkeypad/index.css'
import { type SocialIcon } from "@/types"
import cv from "@cv"
import type { Basics } from "@/data/cv"
const { profiles = [] } = cv.basics as Basics;

const SOCIAL_ICONS: SocialIcon = {
  GitHub: `<svg
  width="16"
  height="16"
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  style="margin-right: 8px"
  ><path
    fill="currentColor"
    d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
  ></path></svg
  >`,
  LinkedIn: `<svg
  height="16"
  width="16"
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  style="margin-right: 8px"
  ><title>LinkedIn</title><path
    fill="currentColor"
    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
  ></path></svg
  >`,
  X: `<svg
  width="16"
  height="16"
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  style="margin-right: 8px"
  ><title>X</title><path
    fill="currentColor"
    d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"
  ></path></svg
  >`,
  Substack: `<svg
  width="16"
  height="16"
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  style="margin-right: 8px"
  ><title>Substack</title><path
    fill="currentColor"
    d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"
  ></path></svg
  >`
}

const TITLE_OVERRIDES: Record<string, string> = {
  Substack: "Read my Blog",
}

const profilesInfo = Array.isArray(profiles)
  ? profiles.map(({ network, url }) => {
      if (!network || !url) return null;

      const icon = SOCIAL_ICONS[network] || null;
      if (!icon) return null;

      const title = TITLE_OVERRIDES[network] || `Visit ${network}`;
      const firstLetter = network[0]?.toUpperCase() ?? "U";

      return {
        id: network,
        section: "Social",
        title,
        url,
        icon,
        hotkey: `ctrl+${firstLetter}`,
      };
    }).filter(Boolean)
  : [];

// Build ChatGPT deep link dynamically from full CV data
const { basics, work = [], education = [], skills = [], projects = [], volunteer = [], publications = [], awards = [], certificates = [], languages = [] } = cv;

const workContext = work.map(w => {
  const dates = w.endDate ? `${w.startDate} to ${w.endDate}` : `${w.startDate} to Present`;
  const bullets = w.highlights?.length ? w.highlights.map(h => `  - ${h}`).join('\n') : w.summary || '';
  return `${w.name} — ${w.position} (${dates})\n${bullets}`;
}).join('\n\n');

const eduContext = education.map(e => {
  const dates = e.endDate ? `${e.startDate} to ${e.endDate}` : `${e.startDate} to Present`;
  return `${e.institution} — ${e.studyType}, ${e.area} (${dates})${e.score ? ` GPA: ${e.score}` : ''}${e.courses?.length ? `\n  Courses: ${e.courses.join(', ')}` : ''}`;
}).join('\n');

const skillNames = skills.map(s => s.name).join(', ');

const projectContext = projects.map(p => {
  const desc = p.description || '';
  const highlights = p.highlights?.length ? p.highlights.map(h => `  - ${h}`).join('\n') : '';
  const links = [p.github, (p as any).url].filter(Boolean).join(', ');
  return `${p.name}: ${desc}${highlights ? '\n' + highlights : ''}${links ? '\n  Links: ' + links : ''}`;
}).join('\n\n');

const volunteerContext = volunteer.map(v => `${v.organization} — ${v.position}: ${v.summary || ''}`).join('\n');

const patentContext = publications.map(p => `${p.name} (${p.publisher})`).join('\n');

const awardContext = awards.map(a => `${a.title} — ${a.awarder} (${new Date(a.date).getFullYear()})`).join('\n');

const certContext = certificates.map(c => `${c.name} — ${c.issuer}`).join('\n');

const profileLinks = profiles.map(p => `${p.network}: ${p.url}`).join('\n');

const chatPrompt = `You are an AI assistant on ${basics?.name}'s portfolio website (${basics?.url}). Answer questions about ${basics?.name} based on the following comprehensive info. Be helpful, concise, and friendly. If asked something not covered, suggest reaching out directly at ${basics?.email}.

## About
${basics?.summary}
Location: ${basics?.location?.city}, ${basics?.location?.region}
Email: ${basics?.email}
Phone: ${basics?.phone}

## Links & Profiles
${profileLinks}
Resume: ${basics?.url}/resume.pdf

## Work Experience
${workContext}

## Education
${eduContext}

## Skills & Technologies
${skillNames}

## Projects
${projectContext}

## Patents
${patentContext}

## Awards & Hackathons
${awardContext}

## Certifications
${certContext}

## Volunteer
${volunteerContext}

## Languages
${languages.map(l => `${l.language} (${l.fluency})`).join(', ')}
`;

const chatURL = `https://chatgpt.com/?q=${encodeURIComponent(chatPrompt)}`;

profilesInfo.push({
  id: "chat-ai",
  section: "Tools",
  title: "Chat with AI about Shubhank",
  url: chatURL,
  icon: `<svg width="16" height="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="margin-right: 8px"><title>Chat</title><path fill="currentColor" d="M22.282 11.704c.626-2.108.2-4.506-1.392-6.098-2.076-2.076-5.236-2.432-7.678-1.074a5.89 5.89 0 0 0-4.756-.972 5.888 5.888 0 0 0-3.724 2.758 5.886 5.886 0 0 0-2.596 3.182 5.889 5.889 0 0 0 .734 4.584A5.882 5.882 0 0 0 4.262 20.182a5.888 5.888 0 0 0 7.678 1.074 5.89 5.89 0 0 0 4.756.972 5.891 5.891 0 0 0 3.724-2.758 5.886 5.886 0 0 0 2.596-3.182 5.889 5.889 0 0 0-.734-4.584zM14.074 21.49a4.407 4.407 0 0 1-2.826-.002l-.144-.058.212-.122 3.492-2.016a.568.568 0 0 0 .286-.494V12.37l1.476.852a.052.052 0 0 1 .028.04v4.076a4.416 4.416 0 0 1-2.524 4.152zM4.478 17.962a4.394 4.394 0 0 1-.526-2.96l.144.086.078.046 3.492 2.016a.57.57 0 0 0 .572 0l4.264-2.462v1.704a.054.054 0 0 1-.022.046l-3.53 2.038a4.414 4.414 0 0 1-4.472.486zM3.382 8.274a4.398 4.398 0 0 1 2.298-1.934l-.002.156v4.032a.57.57 0 0 0 .286.494l4.264 2.462-1.476.852a.054.054 0 0 1-.05.006l-3.53-2.038a4.418 4.418 0 0 1-1.79-5.03zm15.076 3.508-4.264-2.462 1.476-.852a.054.054 0 0 1 .05-.006l3.53 2.038a4.414 4.414 0 0 1 1.318 6.478 4.4 4.4 0 0 1-1.824 1.478v-4.188a.57.57 0 0 0-.286-.494v.008zM17.148 10.1l-.078-.046-3.492-2.016a.57.57 0 0 0-.572 0L8.742 10.5V8.796a.054.054 0 0 1 .022-.046l3.53-2.038a4.414 4.414 0 0 1 4.854 7.388zM8.168 13.13l-1.476-.852a.052.052 0 0 1-.028-.04V8.162a4.414 4.414 0 0 1 4.938-4.39c.97.118 1.882.522 2.612 1.14l-.212.122-3.492 2.016a.568.568 0 0 0-.286.494l-.056 5.586zM9.316 11.5 12 9.95l2.684 1.55v3.1L12 16.15l-2.684-1.55v-3.1z"/></svg>`,
  hotkey: "ctrl+A"
});

profilesInfo.push({
  id: "download-resume",
  section: "Actions",
  title: "Download Shubhank's Resume",
  url: "/resume.pdf",
  icon: `<svg width="16" height="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>`,
  hotkey: "ctrl+D"
});

---

<footer id="normal-footer" class="no-print">
  Press <kbd>Cmd</kbd> + <kbd>K</kbd> to open the command palette.
</footer>

<div id="footer-button" class="no-print">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="icon icon-tabler icon-tabler-command"
    width="32"
    height="32"
    viewBox="0 0 24 24"
    stroke-width="1.5"
    stroke="#777"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
    <path
      d="M7 9a2 2 0 1 1 2 -2v10a2 2 0 1 1 -2 -2h10a2 2 0 1 1 -2 2v-10a2 2 0 1 1 2 2h-10"
    ></path>
  </svg>
</div>

<div
  id="hotkeypad"
  data-placeholder="Search command"
  data-info={JSON.stringify(profilesInfo)}
>
</div>

<script>
  interface Info {
    id: string
    section: string
    title: string
    url: string
    icon: string
    hotkey: string
    handler?: () => void
  }

  import HotKeyPad from "hotkeypad"

  const hotkeypad = new HotKeyPad()
  const info = hotkeypad.instance.getAttribute("data-info") ?? "[]"
  const parsedInfo = JSON.parse(info) as Info[]

  const data = parsedInfo.map(
    ({ url, hotkey, icon, id, section, title }) => {
      return {
        id,
        title,
        icon,
        hotkey,
        section,
        handler: () => {
          window.open(url, "_blank")
        }
      }
    }
  )
  hotkeypad.setCommands([
    {
      id: "print",
      title: "Print",
      icon: `<svg style="margin-right: 8px" width="16" height="16" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
  <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5Zm-3 0h.008v.008H15V10.5Z" />
</svg>`,
      hotkey: "ctrl+P",
      section: "Actions",
      handler: () => {
        window.print()
      }
    },
    ...data
  ])

  const footerButton = document.getElementById("footer-button")
  footerButton?.addEventListener("click", () => {
    var event = new KeyboardEvent("keydown", {
      key: "K",
      code: "KeyK",
      keyCode: 75,
      which: 75,
      ctrlKey: true,
      altKey: false,
      shiftKey: false,
      metaKey: false
    })

    document.dispatchEvent(event)
  })
</script>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (min-width: 601px) {
    #normal-footer {
      display: block;
    }

    #footer-button {
      display: none;
    }
  }

  @media (max-width: 600px) {
    #normal-footer {
      display: none;
    }

    #footer-button {
      background: #fff;
      position: fixed;
      border: 1px solid #eee;
      right: 10px;
      bottom: 10px;
      width: 50px;
      height: 50px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
  }

  footer {
    background: #fdfdfd;
    border-top: 1px solid #eee;
    position: fixed;
    bottom: 0px;
    width: 100%;
    padding-block: 8px;
    text-align: center;
    font-size: 0.85rem;

    view-timeline-name: --revealing;
    view-timeline-axis: block;

    animation: linear 0.3s fadeIn;
    animation-timeline: --revealing;
    animation-range: entry 100% cover 10%;
  }

  kbd {
    background: #eee;
    border-radius: 4px;
    padding: 2px 4px;
    font-size: 12px;
  }
</style>
