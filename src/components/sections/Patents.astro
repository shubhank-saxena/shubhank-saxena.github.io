---
import Section from "../Section.astro"
import { publications as patentsData } from "@cv"
import type { Publications } from "@/data/cv"
const patents = patentsData as Publications[]
---

<Section title="Patents">
  <ul>
    {
      patents.map(({ name, publisher, releaseDate, summary }) => {
        const year = new Date(releaseDate).getFullYear()
        return (
          <li>
            <article>
              <header>
                <div>
                  <h3>{name}</h3>
                  <h4>{publisher}</h4>
                </div>
                <time>{year}</time>
              </header>
              {summary && (
                <footer>
                  <p>{summary}</p>
                </footer>
              )}
            </article>
          </li>
        )
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  article h3 {
    font-weight: 500;
    color: #111;
  }

  article h4 {
    color: #555;
    font-weight: 400;
    font-size: 0.85rem;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  time {
    color: #555;
    font-size: 0.85rem;
    min-width: 102px;
    text-align: right;
  }

  footer p {
    font-size: 0.85rem;
    color: #555;
  }
</style>
