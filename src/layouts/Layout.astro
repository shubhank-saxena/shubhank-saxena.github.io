---
import type { Basics } from "@/data/cv"
import { basics as basicsData } from "@cv"
import cv from "@cv"

interface Props {
  title: string
}

const { title } = Astro.props

const { name, label, email, image, summary, url = "", location, profiles = [] } =
  basicsData as Basics
const ogImage = url && image ? `${url}${image}` : ""

// Google Analytics (GA4). Only loaded in production builds so local dev and
// test builds don't pollute the stats. The Measurement ID is a public client
// identifier, not a secret.
const GA_ID = "G-BM9DP0C2HN"
const enableAnalytics = import.meta.env.PROD

// Structured data (schema.org Person) so search engines and AI crawlers can
// parse who this is. Built from cv.json, so it never drifts from the site.
const { work = [], education = [], skills = [], languages = [] } = cv as any
const currentRole = work[0]

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name,
  url,
  ...(ogImage ? { image: ogImage } : {}),
  ...(email ? { email } : {}),
  ...(currentRole?.position ? { jobTitle: currentRole.position } : label ? { jobTitle: label } : {}),
  ...(summary ? { description: summary } : {}),
  ...(location?.city
    ? {
        address: {
          "@type": "PostalAddress",
          addressLocality: location.city,
          ...(location.region ? { addressRegion: location.region } : {}),
          ...(location.countryCode ? { addressCountry: location.countryCode } : {}),
        },
      }
    : {}),
  ...(currentRole
    ? {
        worksFor: {
          "@type": "Organization",
          name: currentRole.name,
          ...(currentRole.url ? { url: currentRole.url } : {}),
        },
      }
    : {}),
  alumniOf: education.map((e: any) => ({ "@type": "CollegeOrUniversity", name: e.institution })),
  knowsAbout: [
    "Backend engineering",
    "Distributed systems",
    "Infrastructure",
    "Observability",
    "Assistive technology",
    ...skills.flatMap((s: any) => s.items ?? []),
  ],
  knowsLanguage: languages.map((l: any) => l.language),
  sameAs: profiles.map((p: any) => p.url).filter(Boolean),
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={summary} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {url && <link rel="canonical" href={`${url}/`} />}
    <!-- link rel="icon" type="image/svg+xml" href="/favicon.svg" /-->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" as="image" href={image} />

    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={url.split("//")[1] ?? ''} />
    <meta property="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />

    {
      enableAnalytics && (
        <Fragment>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
          <script define:vars={{ gaId: GA_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </Fragment>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html {
    font-size: 19px;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      "Courier New",
      Courier,
      monospace;
    background: #fff;
    letter-spacing: -0.025rem;
  }

  body,
  figure {
    margin: 0;
    padding: 0;
  }

  a {
    text-decoration: none;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
  }

  p {
    color: #666;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    text-wrap: pretty;
  }

  .print {
    display: none !important;
  }

  @media print {
    .no-print {
      display: none !important;
    }

    .print {
      display: block !important;
    }

    astro-dev-toolbar {
      display: none !important;
    }

    article {
      break-inside: avoid;
    }
  }
</style>
